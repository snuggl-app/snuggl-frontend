{
  "format": "page",
  "id": "blog_homepage",
  "label": "Blog Homepage",
  "repeatable": false,
  "status": true,
  "json": {
    "Main": {
      "featured_article": {
        "type": "Link",
        "config": {
          "label": "Featured Article",
          "select": "document",
          "repeat": false,
          "customtypes": [
            {
              "id": "article",
              "fields": ["meta_title", "meta_description", "meta_image"]
            }
          ]
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "newsletter": {
              "type": "SharedSlice"
            },
            "blog_article_grid": {
              "type": "SharedSlice"
            },
            "blog_instagram_cta": {
              "type": "SharedSlice"
            },
            "blog_hero": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  }
}
